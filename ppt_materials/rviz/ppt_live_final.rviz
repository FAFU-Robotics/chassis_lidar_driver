# PPT final capture view. Display/camera only.
# Do not overwrite ppt_live.rviz or maps/mola_lo.rviz.
# Real topics: /rslidar_points + /lidar_odometry/localmap_points + pose/TF.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.42
    Tree Height: 80
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.28
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 72; 72; 80
      Enabled: true
      Line Style:
        Line Width: 0.025
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_footprint:
          Value: false
        base_link:
          Value: true
        map:
          Value: false
        odom:
          Value: false
        rslidar:
          Value: false
      Marker Scale: 0.32
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 0.82
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 2.8
        Min Value: 0.0
        Value: false
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 206; 206; 210
      Color Transformer: FlatColor
      Decay Time: 0.80
      Enabled: true
      Invert Rainbow: false
      Max Color: 230; 230; 232
      Min Color: 78; 78; 86
      Name: RawLidar
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.010
      Style: Points
      Topic:
        Depth: 30
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslidar_points
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Alpha: 0.92
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 3.2
        Min Value: 0.0
        Value: false
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 196; 152; 72
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: LocalMap
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.028
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lidar_odometry/localmap_points
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Angle Tolerance: 0.02
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Value: false
        Position:
          Value: false
        Value: false
      Enabled: true
      Keep: 1
      Name: LidarPose
      Position Tolerance: 0.01
      Shape:
        Alpha: 1
        Axes Length: 0.36
        Axes Radius: 0.028
        Color: 255; 90; 50
        Head Length: 0.10
        Head Radius: 0.04
        Shaft Length: 0.22
        Shaft Radius: 0.022
        Value: Axes
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lidar_odometry/pose
      Value: true
  Enabled: true
  Global Options:
    Background Color: 0; 0; 0
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Distance: 11.8
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 5.0
        Y: 1.20
        Z: 0.40
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.02
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.88
      Target Frame: map
      Value: XYOrbit (rviz_default_plugins)
      Yaw: 1.57
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 580
  Hide Left Dock: true
  Hide Right Dock: true
  QMainWindow State: 
  Time:
    collapsed: true
  Views:
    collapsed: true
  Width: 780
  X: 10
  Y: 10
