# P2 localmap-only view to match PPT target. Display/camera only.
# Do not overwrite ppt_live.rviz / ppt_live_final.rviz.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
      Splitter Ratio: 0.4
    Tree Height: 60
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.18
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 55; 55; 62
      Enabled: true
      Line Style:
        Line Width: 0.02
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: false
        base_footprint:
          Value: false
        base_link:
          Value: true
        map:
          Value: false
        odom:
          Value: false
        rslidar:
          Value: false
      Marker Scale: 0.22
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 0.25
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 3.0
        Min Value: 0.0
        Value: false
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 160; 160; 168
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Name: RawLidar
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 1
      Size (m): 0.008
      Style: Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslidar_points
      Use Fixed Frame: true
      Use rainbow: false
      Value: false
    - Alpha: 1.0
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 3.0
        Min Value: 0.0
        Value: false
      Axis: Z
      Channel Name: z
      Class: rviz_default_plugins/PointCloud2
      Color: 228; 228; 232
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Name: LocalMap
      Position Transformer: XYZ
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.025
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lidar_odometry/localmap_points
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Angle Tolerance: 0.02
      Class: rviz_default_plugins/Odometry
      Covariance:
        Orientation:
          Value: false
        Position:
          Value: false
        Value: false
      Enabled: false
      Keep: 4000
      Name: LidarPose
      Position Tolerance: 0.03
      Shape:
        Alpha: 0.9
        Axes Length: 0.22
        Axes Radius: 0.016
        Color: 40; 210; 80
        Head Length: 0.06
        Head Radius: 0.025
        Shaft Length: 0.12
        Shaft Radius: 0.012
        Value: Axes
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lidar_odometry/pose
      Value: true
  Enabled: true
  Global Options:
    Background Color: 8; 10; 14
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/XYOrbit
      Distance: 12.0
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 1.80
        Y: -1.10
        Z: 0.35
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.012
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.05
      Target Frame: map
      Value: XYOrbit (rviz_default_plugins)
      Yaw: 0.85
    Saved: ~
Window Geometry:
  Displays:
    collapsed: true
  Height: 580
  Hide Left Dock: true
  Hide Right Dock: true
  QMainWindow State: 
  Time:
    collapsed: true
  Views:
    collapsed: true
  Width: 780
  X: 10
  Y: 10
